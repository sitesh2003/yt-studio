# Copy this file to .env and paste your own keys. Never share .env or commit it.

# Free: https://aistudio.google.com/apikey  (script, titles, comment replies)
GEMINI_API_KEY=

# Free: https://pixabay.com/api/docs/  (stock video clips; sign up, the key is shown on that page)
PIXABAY_API_KEY=

# Optional, only if you already have one (Pexels has paused new keys)
PEXELS_API_KEY=

# Free: Google Cloud console > YouTube Data API v3 > API key  (trend research only)
YOUTUBE_API_KEY=

# Uploading, comments and analytics use OAuth instead of a key:
# download the OAuth client file from Google Cloud and save it as client_secret.json in this folder.
