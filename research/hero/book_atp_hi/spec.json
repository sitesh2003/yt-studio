    "electrons passed along": "\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928 \u0906\u0917\u0947 \u092c\u0922\u093c\u0924\u0947 \u0939\u0948\u0902",
    "heart and brain hit hardest": "\u0926\u093f\u0932 \u0914\u0930 \u0926\u093f\u092e\u093e\u0917\u093c \u092a\u0930 \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0905\u0938\u0930",
    "in your whole body at once": "\u092a\u0942\u0930\u0947 \u0936\u0930\u0940\u0930 \u092e\u0947\u0902 \u090f\u0915 \u0938\u092e\u092f \u092a\u0930",
